# ============================================================
# .env.example — Mobile Brands GCP Pipeline
# ============================================================
# SAFE TO COMMIT — contains placeholder values only.
#
# HOW TO USE:
#   Copy this file and fill in your real values:
#
#   For development:
#     cp .env.example .env.dv
#     # edit .env.dv with real dv project values
#
#   For production:
#     cp .env.example .env.pd
#     # edit .env.pd with real prod project values
#
# NEVER commit .env.dv or .env.pd — they are in .gitignore
# ============================================================


# ─────────────────────────────────────
# ENVIRONMENT IDENTIFIER
# ─────────────────────────────────────
# Which environment this file is for: "dv" or "pd"
MB_ENV=dv


# ─────────────────────────────────────
# GCP PROJECT
# ─────────────────────────────────────
# DV project:   dv-env
# PD project:   prod-env
PROJECT_ID=dv-env


# ─────────────────────────────────────
# GCP REGION
# ─────────────────────────────────────
REGION=us-central1


# ─────────────────────────────────────
# GCS BUCKETS
# ─────────────────────────────────────
# Source bucket — where distributors upload Excel files
# DV:  dv-mobile-brands
# PD:  mobile-brands
SOURCE_BUCKET=dv-mobile-brands

# Pipeline bucket — raw/, bronze/, silver/, gold/, scripts/
# DV:  dv-mb-pipeline-bucket
# PD:  pd-mb-pipeline-bucket
DEST_BUCKET=dv-mb-pipeline-bucket


# ─────────────────────────────────────
# CLOUD RUN
# ─────────────────────────────────────
# The Cloud Run service URL (get this after deploy.sh runs)
# Example: https://dv-mb-extractor-abcde-uc.a.run.app
# DV service name:  dv-mb-extractor
# PD service name:  pd-mb-extractor
CLOUD_RUN_URL=https://FILL_IN_AFTER_DEPLOY.run.app

# Cloud Run service name
# DV: dv-mb-extractor
# PD: pd-mb-extractor
CLOUD_RUN_SERVICE=dv-mb-extractor


# ─────────────────────────────────────
# BIGQUERY
# ─────────────────────────────────────
# BigQuery dataset name (same in both envs)
BQ_DATASET=mobile_brands

# Full table references (auto-derived from PROJECT_ID + BQ_DATASET)
# silver_sales        → PROJECT_ID.mobile_brands.silver_sales
# gold_brand_kpi      → PROJECT_ID.mobile_brands.gold_brand_kpi
# gold_region_summary → PROJECT_ID.mobile_brands.gold_region_summary
# gold_daily_trend    → PROJECT_ID.mobile_brands.gold_daily_trend


# ─────────────────────────────────────
# CLOUD COMPOSER (AIRFLOW)
# ─────────────────────────────────────
# Composer environment name
# DV: dv-mb-composer
# PD: pd-mb-composer
COMPOSER_ENV=dv-mb-composer

# Composer GCS bucket (fill after Composer is created)
# Get via: gcloud composer environments describe dv-mb-composer \
#          --location=us-central1 --format="value(config.dagGcsPrefix)"
COMPOSER_BUCKET=FILL_IN_AFTER_COMPOSER_CREATED


# ─────────────────────────────────────
# DATAPROC
# ─────────────────────────────────────
# Dataproc cluster name prefix
# DV: dv-mb-dataproc
# PD: pd-mb-dataproc
DATAPROC_CLUSTER=dv-mb-dataproc


# ─────────────────────────────────────
# SERVICE ACCOUNT
# ─────────────────────────────────────
# Format: mb-pipeline-sa@PROJECT_ID.iam.gserviceaccount.com
SERVICE_ACCOUNT=mb-pipeline-sa@dv-env.iam.gserviceaccount.com


# ─────────────────────────────────────
# ARTIFACT REGISTRY
# ─────────────────────────────────────
# Format: REGION-docker.pkg.dev/PROJECT_ID/mb-repo
ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/dv-env/mb-repo


# ─────────────────────────────────────
# GITHUB (for Cloud Build Triggers)
# ─────────────────────────────────────
GITHUB_OWNER=YOUR_GITHUB_USERNAME
GITHUB_REPO=YOUR_REPO_NAME


# ─────────────────────────────────────
# LOGGING
# ─────────────────────────────────────
LOG_LEVEL=INFO
